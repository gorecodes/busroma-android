<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Serve per interrogare le API: senza questo ogni chiamata fallisce
         con un errore che non nomina il permesso. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Posizione: solo APPROSSIMATA. Per sapere quali fermate hai intorno
         bastano un centinaio di metri di precisione, e chiedere quella fine
         sarebbe chiedere piu' del necessario - cosa che l'utente vede nella
         schermata del permesso e che il Play Store chiede di giustificare.
         Non e' obbligatoria: l'app funziona interamente con ricerca e
         preferiti, quindi required="false". -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <application
        android:label="Bus Roma"
        android:supportsRtl="true"
        android:theme="@style/Theme.BusRoma">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Bus Roma">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
